$pio = "$env:USERPROFILE\.platformio\penv\Scripts\platformio.exe"
$objcopy = "$env:USERPROFILE\.platformio\packages\toolchain-gccarmnoneeabi\bin\arm-none-eabi-objcopy.exe"
$nrfutil = "$env:USERPROFILE\.platformio\packages\framework-arduinoadafruitnrf52\tools\adafruit-nrfutil\win32\adafruit-nrfutil.exe"

& $pio run -e nrf52832_custom

& $objcopy -O ihex `
  ".pio\build\nrf52832_custom\firmware.elf" `
  ".pio\build\nrf52832_custom\firmware.hex"

& $nrfutil dfu genpkg `
  --dev-type 0x0052 `
  --sd-req 0x00B7 `
  --application ".pio\build\nrf52832_custom\firmware.hex" `
  ".pio\build\nrf52832_custom\Alignpod_1.2.0.zip"
